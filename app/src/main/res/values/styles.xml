<resources>
    <style name="AppThemeBase" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#956047</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#FFF9F0</item>
    </style>
    <style name="AppTheme" parent="AppThemeBase" />
    <style name="HistoryDrawerAnimation">
        <item name="android:windowEnterAnimation">@anim/history_enter</item>
        <item name="android:windowExitAnimation">@anim/history_exit</item>
    </style>
</resources>
