# Generate per-install secrets with python3 scripts/init-env.py; never commit .env.
MOZHI_MODERATOR_TOKEN=
# Comma-separated, revocable per-device random tokens (>=32 URL-safe characters).
MOZHI_WEB_TOKENS=
MOZHI_SEARCH_PROVIDER=duckduckgo
# For dependable provider-backed search select brave, then set its own API key.
BRAVE_SEARCH_API_KEY=
MOZHI_LOCAL_PORT=8090
MOZHI_IMAGE_TAG=0.5.0
MOZHI_DOMAIN=
MOZHI_ACME_EMAIL=
